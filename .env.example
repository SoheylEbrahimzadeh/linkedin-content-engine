# Copy to .env (never committed). This file contains NO real values.
#
# Path to your private data directory (a clone of your private data repo).
# Must be OUTSIDE this repository; the engine refuses to run otherwise.
LCE_DATA_DIR=/absolute/path/to/your-private-data-repo

# Optional: path to a local, never-committed denylist of private terms
# (employer names, client names, etc.) used by the privacy scanner.
# Default: ~/.lce-private/denylist.txt
LCE_DENYLIST_PATH=

# This project does NOT use the Anthropic API. Do not set ANTHROPIC_API_KEY:
# LLM steps run inside Claude Code (subscription), not from this code.
#
# Publishing-provider credentials are added in a later phase, only after the
# provider is chosen. They belong in your secret store, never in this file.
