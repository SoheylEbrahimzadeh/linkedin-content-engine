{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/image.schema.json",
  "title": "Image decision",
  "description": "Per-post image decision (posts/<id>/image.yaml). 'none' is a valid, explicit decision. An image is never decoration: it needs a stated relation to the post and a provenance record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "rationale",
    "decided_at"
  ],
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "none",
        "source_image",
        "diagram",
        "architecture",
        "screenshot",
        "chart",
        "generated_concept"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "description": "Why this kind of image (or no image) serves the post."
    },
    "relation": {
      "type": "string",
      "description": "What the image shows and how it supports the post's point."
    },
    "file": {
      "type": "string",
      "pattern": "^image\\.(png|jpg|jpeg|gif)$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes": {
      "type": "integer",
      "minimum": 1
    },
    "alt_text": {
      "type": "string"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "usage"
      ],
      "properties": {
        "origin": {
          "enum": [
            "own_creation",
            "owner_screenshot",
            "owner_photo",
            "source_publication",
            "licensed_stock",
            "generated"
          ]
        },
        "source_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "credit": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "usage": {
          "enum": [
            "owned",
            "licensed",
            "permitted",
            "public_domain",
            "needs_review",
            "owner_accepted_risk"
          ],
          "description": "needs_review blocks approval until the owner resolves it. owner_accepted_risk: a source's own image used by the owner's decision without a licence (always credited)."
        },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "Tool or code used (e.g. a diagram script or an image model)."
            },
            "prompt": {
              "type": "string"
            },
            "at": {
              "type": "string"
            }
          }
        },
        "license_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "title": {
          "type": "string"
        },
        "creator": {
          "type": "string",
          "description": "LCE-043: author of the file as stated by its source."
        },
        "attribution_required": {
          "type": "boolean"
        },
        "attribution": {
          "type": "string",
          "description": "Credit line to show with the post."
        },
        "retrieved_at": {
          "type": "string"
        },
        "retrieved": {
          "type": "string",
          "description": "original, or the source's rendered thumbnail of the same file"
        },
        "retrieved_url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "original_sha1": {
          "type": "string"
        },
        "source_id": {
          "type": "string",
          "description": "LCE-044: the file's identifier at its source (Commons title, openverse:<uuid>)."
        },
        "source_name": {
          "type": "string"
        }
      }
    },
    "decided_at": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "text_only_reason": {
      "enum": [
        "text_carries_point",
        "no_relevant_visual",
        "no_rights_safe_source",
        "personal_story_without_owner_photo",
        "would_be_decorative",
        "no_suitable_licensed_image"
      ],
      "description": "Why the post stays text-only (LCE-038)."
    },
    "mime": {
      "enum": [
        "image/png",
        "image/jpeg",
        "image/gif"
      ]
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a generated visual draws (LCE-040/041): the relevance check re-evaluates it against the current text.",
      "properties": {
        "title": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "footer": {
          "type": "string"
        },
        "visual_type": {
          "type": "string"
        },
        "concept": {
          "type": "string"
        },
        "relevance_reason": {
          "type": "string"
        },
        "center": {
          "type": "string"
        },
        "decision_label": {
          "type": "string"
        },
        "source_line": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "media_relevance": {
      "type": "object",
      "additionalProperties": true,
      "description": "LCE-041 semantic relevance record of the visual (machine-checked).",
      "required": [
        "visual_type",
        "copied_post_text_ratio",
        "factual_claims",
        "source_requirements",
        "media_decision"
      ],
      "properties": {
        "concept": {
          "type": [
            "string",
            "null"
          ]
        },
        "visual_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "relevance_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "copied_post_text_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "factual_claims": {
          "type": "array"
        },
        "source_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "media_decision": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "problems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": true,
      "description": "LCE-043: how a real image was searched for: subject, concept, subject terms, every candidate tried and why it was refused or selected.",
      "required": [
        "subject",
        "subject_terms",
        "tried"
      ],
      "properties": {
        "subject": {
          "type": "string"
        },
        "concept": {
          "type": "string"
        },
        "subject_terms": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tried": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "selected": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_visual": {
      "type": "object",
      "additionalProperties": true,
      "description": "LCE-046: the source-first decision: the post's source page was inspected for its own visual.",
      "required": [
        "status",
        "source_url",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "source_visual_used",
            "source_visual_unavailable_or_restricted",
            "no_source_visual"
          ]
        },
        "source_url": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        }
      }
    }
  }
}
