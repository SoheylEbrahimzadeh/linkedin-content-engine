{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/voice.schema.json",
  "title": "VoiceProfile",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "language": {
      "enum": [
        "en",
        "de",
        "fa"
      ]
    },
    "source": {
      "enum": [
        "interview",
        "sample_posts",
        "both"
      ]
    },
    "tone": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formality": {
      "enum": [
        "casual",
        "neutral",
        "formal"
      ]
    },
    "sentence_length": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preference": {
          "enum": [
            "short",
            "mixed",
            "long"
          ]
        },
        "target_avg_words": {
          "type": "integer",
          "minimum": 4,
          "maximum": 40
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefer": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hook_style": {
          "type": "string"
        }
      }
    },
    "storytelling_style": {
      "type": "string"
    },
    "technical_depth": {
      "enum": [
        "low",
        "medium",
        "high",
        "mixed"
      ]
    },
    "opinions_vs_facts": {
      "type": "string"
    },
    "cta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "boolean"
        },
        "style": {
          "type": "string"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "avoid_phrases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "formatting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_chars": {
          "type": "integer",
          "minimum": 200,
          "maximum": 3000
        },
        "bullets_allowed": {
          "type": "boolean"
        },
        "line_breaks": {
          "type": "string"
        },
        "em_dash_allowed": {
          "type": "boolean",
          "description": "false: an em dash (—) blocks QA (owner rule)."
        },
        "guillemets_allowed": {
          "type": "boolean",
          "description": "false: guillemets (« ») block QA (owner rule)."
        },
        "editorial_phrases_allowed": {
          "type": "boolean",
          "description": "false: analyst/editorial phrases and label-colon constructions block QA (owner rule)."
        },
        "symmetry_allowed": {
          "type": "boolean",
          "description": "false: three-part lists and parallel sentence openers block QA (owner rule)."
        }
      }
    },
    "emoji_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_per_post": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "hashtag_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "placement": {
          "enum": [
            "end",
            "inline",
            "none"
          ]
        }
      }
    },
    "sample_count": {
      "type": "integer",
      "minimum": 0
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bumped when the voice profile changes (LCE-037)."
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Where each field comes from: owner answer, or 'derived: …' from profile/brand (LCE-037)."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending_owner_review",
            "confirmed"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "point_of_view": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "person": {
          "enum": [
            "first",
            "third",
            "mixed"
          ]
        },
        "first_person": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "string"
    },
    "individual_voice": {
      "type": "string",
      "description": "How the writing sounds like one person, not a company page."
    },
    "avoid_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "derived_from": {
            "type": "string"
          }
        }
      }
    },
    "rhythm": {
      "$ref": "#/$defs/trait",
      "description": "sentence rhythm and length variation"
    },
    "opinion_style": {
      "$ref": "#/$defs/trait",
      "description": "how opinions are stated"
    },
    "disagreement_style": {
      "$ref": "#/$defs/trait",
      "description": "how disagreement is expressed"
    },
    "humor": {
      "$ref": "#/$defs/trait",
      "description": "degree and type of humour"
    },
    "openings": {
      "$ref": "#/$defs/trait",
      "description": "how posts open"
    },
    "transitions": {
      "$ref": "#/$defs/trait",
      "description": "how ideas connect"
    },
    "endings": {
      "$ref": "#/$defs/trait",
      "description": "how posts end"
    },
    "networking": {
      "$ref": "#/$defs/trait",
      "description": "how the owner invites professional contact (never transactional)"
    },
    "technical_business_balance": {
      "$ref": "#/$defs/trait",
      "description": "technical vs business emphasis"
    },
    "explanation_style": {
      "$ref": "#/$defs/trait",
      "description": "how problems are explained"
    },
    "uncertainty_style": {
      "$ref": "#/$defs/trait",
      "description": "how uncertainty is expressed"
    },
    "challenge_style": {
      "$ref": "#/$defs/trait",
      "description": "how common assumptions are challenged"
    },
    "signature_patterns": {
      "$ref": "#/$defs/trait",
      "description": "recognizable writing patterns (from real samples)"
    },
    "anti_generic": {
      "$ref": "#/$defs/trait",
      "description": "owner rules against corporate/generic writing"
    },
    "first_person_style": {
      "$ref": "#/$defs/trait",
      "description": "how first person is used"
    },
    "preferred_vocabulary": {
      "$ref": "#/$defs/trait",
      "description": "words and phrases the owner actually uses"
    },
    "avoided_vocabulary": {
      "$ref": "#/$defs/trait",
      "description": "words the owner never uses"
    },
    "registers": {
      "$ref": "#/$defs/trait",
      "description": "Which registers posts use and in what balance (owner decision)."
    },
    "counter_examples": {
      "$ref": "#/$defs/trait",
      "description": "Sentences the owner marked as NOT their voice (never imitate)."
    },
    "natural_phrases": {
      "$ref": "#/$defs/trait",
      "description": "phrases and words the owner naturally uses"
    },
    "communication_habits": {
      "$ref": "#/$defs/trait",
      "description": "how the owner usually communicates with colleagues and managers"
    },
    "reasoning_patterns": {
      "$ref": "#/$defs/trait",
      "description": "the order in which the owner reasons through a problem"
    },
    "professional_priorities": {
      "$ref": "#/$defs/trait",
      "description": "what the owner genuinely cares about in professional work"
    }
  },
  "$defs": {
    "trait": {
      "description": "A voice trait in the owner's terms, or an explicit request for owner input (never guessed).",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "object",
          "required": [
            "owner_input_required"
          ],
          "additionalProperties": false,
          "properties": {
            "owner_input_required": {
              "const": true
            },
            "question": {
              "type": "string"
            },
            "derived_hint": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
