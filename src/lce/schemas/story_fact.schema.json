{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/story_fact.schema.json",
  "title": "StoryFact",
  "description": "One verified fact the writer may draw on. Only PUBLIC facts may appear in drafts.",
  "type": "object",
  "required": ["fact_id", "title", "description", "period", "my_role", "evidence",
               "publication_status", "sensitivity", "allowed_topics", "allowed_claims"],
  "additionalProperties": false,
  "properties": {
    "demo": {"type": "boolean"},
    "fact_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "title": {"type": "string", "minLength": 3},
    "description": {"type": "string", "minLength": 10},
    "period": {"type": "string", "description": "e.g. 2024-Q2 or 2023-03/2024-01"},
    "my_role": {"type": "string"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "ref"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["self_reported", "document", "public_url", "repository", "other"]},
          "ref": {"type": "string"}
        }
      }
    },
    "publication_status": {"enum": ["PUBLIC", "PRIVATE", "NEEDS_APPROVAL"]},
    "sensitivity": {"enum": ["low", "medium", "high"]},
    "allowed_topics": {"type": "array", "items": {"type": "string"}},
    "allowed_claims": {
      "type": "array",
      "description": "Exact claims (including numbers) that may be stated publicly.",
      "items": {"type": "string"}
    },
    "approved_at": {"type": "string", "format": "date"},
    "notes": {"type": "string"}
  },
  "if": {"properties": {"publication_status": {"const": "PUBLIC"}}},
  "then": {"required": ["approved_at"]}
}
