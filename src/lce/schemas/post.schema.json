{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/post.schema.json",
  "title": "PostRecord",
  "type": "object",
  "required": [
    "post_id",
    "created_at",
    "language",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "post_id": {
      "type": "string",
      "pattern": "^\\d{8}-[a-z0-9-]{1,56}$"
    },
    "created_at": {
      "type": "string"
    },
    "plan_date": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "enum": [
        "en",
        "de",
        "fa"
      ]
    },
    "topic": {
      "type": "string"
    },
    "pillar": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "angle": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_url"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 3
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "stories_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "brand": {
      "type": "object",
      "description": "Personal-brand placement of this post (theme, evidence mode, career chapter).",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "chapter": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "evidence": {
          "enum": [
            "personal",
            "external"
          ]
        }
      }
    },
    "state": {
      "enum": [
        "RESEARCHED",
        "SELECTED",
        "NEEDS_INPUT",
        "DRAFTED",
        "HUMANIZED",
        "NEEDS_REVISION",
        "QA_PASSED",
        "DUPLICATE_CHECKED",
        "AWAITING_APPROVAL",
        "APPROVED",
        "READY_TO_PUBLISH",
        "REJECTED",
        "PUBLISHING",
        "PUBLISHED",
        "PUBLISH_FAILED",
        "NEEDS_RECONCILE"
      ]
    },
    "draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "at": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "at": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_at": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "image_hash": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|none)$",
          "description": "SHA-256 of the approved image file, or 'none' for an explicit no-image decision."
        },
        "reason": {
          "type": "string"
        },
        "decision_id": {
          "type": "string",
          "description": "Cloud Control Center decision applied by the private workflow (LCE-036)."
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "regeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at",
        "reason"
      ],
      "description": "Owner asked for a rewrite from the Control Center (LCE-036); the next drafting session handles it.",
      "properties": {
        "requested_at": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        }
      }
    },
    "duplicated_from": {
      "type": "string",
      "description": "post_id this post was copied from (LCE-036)."
    },
    "objective": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Id from voice.yaml objectives (LCE-037)."
    },
    "humanization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "source"
      ],
      "description": "What the humanized text was written against (LCE-037).",
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "source": {
          "enum": [
            "session",
            "owner_edit"
          ]
        },
        "voice_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "voice_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "profile_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "brand_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "checklist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "passed": {
              "type": "integer"
            },
            "failed": {
              "type": "integer"
            },
            "review": {
              "type": "integer"
            }
          }
        }
      }
    },
    "refresh_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_at"
      ],
      "description": "LCE-041: owner asked for a full refresh (new post package) from the Control Center; a writing session produces it.",
      "properties": {
        "requested_at": {
          "type": "string"
        },
        "requested_by": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "rejected_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "owner",
            "freshness"
          ],
          "description": "owner = Refresh in the Control Center; freshness = the schedule-derived freshness check found the post stale (LCE-049)"
        },
        "stale": {
          "type": "object",
          "description": "what the freshness check found (reason, missing claims, slot)",
          "additionalProperties": true
        }
      }
    },
    "refresh": {
      "type": "object",
      "additionalProperties": false,
      "description": "LCE-041: the last completed manual refresh (the previous version is kept in versions/).",
      "properties": {
        "completed_at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "outcome": {
          "enum": [
            "refreshed",
            "kept"
          ]
        },
        "previous_version": {
          "type": [
            "integer",
            "null"
          ]
        },
        "requested_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "enum": [
            "owner",
            "freshness"
          ]
        }
      }
    },
    "content_type": {
      "enum": [
        "external_insight",
        "personal_pov",
        "personal_lesson",
        "how_to",
        "observation"
      ],
      "description": "external_insight | personal_pov | personal_lesson | how_to | observation (LCE-051)."
    },
    "opinions_used": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
      },
      "description": "Golden-set ids (opinions, disagreements, approaches) whose owner-confirmed view this post expresses."
    },
    "observations_used": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
      },
      "description": "Golden-set observation ids backing first-person observations."
    },
    "angle_origin": {
      "enum": [
        "owner",
        "proposed"
      ],
      "description": "owner: the angle comes from an owner-confirmed opinion; proposed: the writer's angle, never written as the owner's belief."
    },
    "voice_gate_review": {
      "type": "object",
      "additionalProperties": false,
      "description": "Manual owner Voice Gate review, bound to the text's content hash (a review of another text is stale).",
      "required": [
        "content_hash",
        "reviewer",
        "at",
        "natural_english",
        "owner_grounded_meaning",
        "owner_phrasing"
      ],
      "properties": {
        "content_hash": {
          "type": "string"
        },
        "reviewer": {
          "enum": [
            "owner",
            "writer"
          ]
        },
        "at": {
          "type": "string"
        },
        "natural_english": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "insufficient"
          ]
        },
        "owner_phrasing": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "insufficient"
          ]
        },
        "notes": {
          "type": "string"
        },
        "owner_grounded_meaning": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "insufficient"
          ]
        }
      }
    },
    "archived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "by",
        "state"
      ],
      "properties": {
        "at": {
          "type": "string"
        },
        "by": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "decision_id": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      },
      "description": "Taken out of the operational views (Overview, Upcoming) by the owner. Display only: the state, history, versions and audit records stay; only REJECTED or PUBLISHED posts are archived."
    },
    "archive_history": {
      "type": "array",
      "description": "Earlier archive and restore actions (audit; never rewritten).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "at",
          "by"
        ],
        "properties": {
          "action": {
            "enum": [
              "archived",
              "restored"
            ]
          },
          "at": {
            "type": "string"
          },
          "by": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "decision_id": {
            "type": "string"
          }
        }
      }
    }
  }
}
