{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/post.schema.json",
  "title": "PostRecord",
  "type": "object",
  "required": [
    "post_id",
    "created_at",
    "language",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "post_id": {
      "type": "string",
      "pattern": "^\\d{8}-[a-z0-9-]{1,56}$"
    },
    "created_at": {
      "type": "string"
    },
    "plan_date": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "enum": [
        "en",
        "de",
        "fa"
      ]
    },
    "topic": {
      "type": "string"
    },
    "pillar": {
      "type": "string"
    },
    "format": {
      "type": "string"
    },
    "angle": {
      "type": "string"
    },
    "candidate_id": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url"
        ],
        "additionalProperties": false,
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "title": {
            "type": "string"
          },
          "publisher": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_url"
        ],
        "additionalProperties": false,
        "properties": {
          "text": {
            "type": "string",
            "minLength": 3
          },
          "source_url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "stories_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "RESEARCHED",
        "SELECTED",
        "NEEDS_INPUT",
        "DRAFTED",
        "HUMANIZED",
        "NEEDS_REVISION",
        "QA_PASSED",
        "DUPLICATE_CHECKED",
        "AWAITING_APPROVAL",
        "APPROVED",
        "READY_TO_PUBLISH",
        "REJECTED",
        "PUBLISHING",
        "PUBLISHED",
        "PUBLISH_FAILED",
        "NEEDS_RECONCILE"
      ]
    },
    "draft_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "at": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "duplicate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed"
          ]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "at": {
          "type": "string"
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approved_at": {
          "type": "string"
        },
        "approved_by": {
          "type": "string"
        },
        "artifact_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "at": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
