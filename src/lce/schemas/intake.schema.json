{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/intake.schema.json",
  "title": "OwnerIntake",
  "description": "Owner-material intake: raw answer, normalized proposal, owner confirmation. Nothing here is owner material until confirmed.",
  "type": "object",
  "required": [
    "round",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "round": {
      "type": "integer",
      "minimum": 1
    },
    "opened": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "already_confirmed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "question",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "kind": {
            "enum": [
              "samples",
              "opinions",
              "disagreements",
              "approaches",
              "observations",
              "principles",
              "noticings",
              "explanations",
              "never_say",
              "priorities",
              "voice_trait",
              "public_use"
            ]
          },
          "section": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 5
          },
          "target_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "trait": {
            "type": "string"
          },
          "draft": {
            "type": "string",
            "description": "An existing draft wording the owner is asked to confirm, correct or reject."
          },
          "optional": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "open",
              "answered",
              "proposed",
              "unresolved",
              "confirmed",
              "rejected"
            ]
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "raw",
                "at"
              ],
              "additionalProperties": false,
              "properties": {
                "raw": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string"
                }
              }
            }
          },
          "proposal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 3
              },
              "why": {
                "type": "string"
              },
              "instead": {
                "type": "string"
              },
              "applies_to": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "public_use": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "scope": {
                "type": "object",
                "additionalProperties": false,
                "description": "Semantic scope: what the item does and does not say. Used to reject stronger, narrower, broader or different positions.",
                "properties": {
                  "meaning": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Atomic statements the item makes."
                  },
                  "strength": {
                    "enum": [
                      "tentative",
                      "conditional",
                      "normal",
                      "strong",
                      "absolute"
                    ]
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Concrete actions the owner explicitly commits to (verbs or short phrases)."
                  },
                  "topics": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "agrees_with": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "excludes": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "description": "Readings the item explicitly does not make."
                  }
                }
              },
              "allowed_paraphrases": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "forbidden_interpretations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 5
                }
              },
              "ambiguities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "proposal_hash": {
            "type": "string"
          },
          "proposed_by": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
