{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/golden.schema.json",
  "title": "GoldenVoiceSet",
  "description": "Private Golden Voice Set (owner-provided material only). Items count as evidence only with status owner_confirmed and an owner source.",
  "type": "object",
  "required": [
    "kind",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "samples",
        "opinions",
        "disagreements",
        "approaches",
        "observations",
        "principles",
        "noticings",
        "explanations",
        "never_say",
        "priorities"
      ]
    },
    "instructions": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "status",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "description": "The normalized wording the owner confirmed (English). The owner's raw words are kept unchanged in `original`."
          },
          "why": {
            "type": "string",
            "description": "Reasoning in the owner's words."
          },
          "instead": {
            "type": "string",
            "description": "disagreements: what the owner does or believes instead."
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Pillar ids or topic keywords."
          },
          "context": {
            "type": "string",
            "description": "Non-confidential context (no client, employer or project names)."
          },
          "medium": {
            "enum": [
              "post",
              "message",
              "talk",
              "note",
              "other"
            ]
          },
          "date": {
            "type": "string"
          },
          "status": {
            "enum": [
              "owner_confirmed",
              "draft",
              "proposed",
              "unresolved"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^owner-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "publishable": {
            "type": "boolean",
            "description": "May the substance appear in a post (default false for samples)."
          },
          "original": {
            "type": "string",
            "description": "The owner's raw answer, exactly as given (any language). Never overwritten."
          },
          "confidence": {
            "enum": [
              "confirmed",
              "proposed",
              "unresolved"
            ],
            "description": "confirmed: the owner confirmed this normalized interpretation; proposed: awaiting confirmation; unresolved: ambiguous, kept as is."
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "channel": {
                "type": "string"
              },
              "question_id": {
                "type": "string"
              },
              "recorded_at": {
                "type": "string"
              },
              "confirmed_at": {
                "type": "string"
              },
              "proposal_hash": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "public_use": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "May the substance appear in a public post (null: not asked yet)."
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "description": "Semantic scope: what the item does and does not say. Used to reject stronger, narrower, broader or different positions.",
            "properties": {
              "meaning": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Atomic statements the item makes."
              },
              "strength": {
                "enum": [
                  "tentative",
                  "conditional",
                  "normal",
                  "strong",
                  "absolute"
                ]
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Concrete actions the owner explicitly commits to (verbs or short phrases)."
              },
              "topics": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "agrees_with": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "excludes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "Readings the item explicitly does not make."
              }
            }
          },
          "allowed_paraphrases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "forbidden_interpretations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 5
            }
          },
          "ambiguities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
