{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/golden.schema.json",
  "title": "GoldenVoiceSet",
  "description": "Private Golden Voice Set (owner-provided material only). Items count as evidence only with status owner_confirmed and an owner source.",
  "type": "object",
  "required": [
    "kind",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "samples",
        "opinions",
        "disagreements",
        "approaches",
        "observations",
        "principles"
      ]
    },
    "instructions": {
      "type": "string"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "status",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 10,
            "description": "The owner's own words: the sample, belief, rejected idea, approach or observation."
          },
          "why": {
            "type": "string",
            "description": "Reasoning in the owner's words."
          },
          "instead": {
            "type": "string",
            "description": "disagreements: what the owner does or believes instead."
          },
          "applies_to": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Pillar ids or topic keywords."
          },
          "context": {
            "type": "string",
            "description": "Non-confidential context (no client, employer or project names)."
          },
          "medium": {
            "enum": [
              "post",
              "message",
              "talk",
              "note",
              "other"
            ]
          },
          "date": {
            "type": "string"
          },
          "status": {
            "enum": [
              "owner_confirmed",
              "draft"
            ]
          },
          "source": {
            "type": "string",
            "pattern": "^owner-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "publishable": {
            "type": "boolean",
            "description": "May the substance appear in a post (default false for samples)."
          }
        }
      }
    }
  }
}
