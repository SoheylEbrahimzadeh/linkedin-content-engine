{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/radar.schema.json",
  "title": "RadarConfig",
  "description": "LCE-050 Content Radar sources (config/radar.yaml). Public machine-readable feeds only; never credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sources"],
  "properties": {
    "demo": {"type": "boolean"},
    "max_age_days": {"type": "integer", "minimum": 1, "maximum": 365},
    "fresh_days": {"type": "integer", "minimum": 1, "maximum": 90},
    "pillar_keywords": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,60}$"},
          "name": {"type": "string"},
          "kind": {"enum": ["feed", "reddit", "github_releases"]},
          "url": {"type": "string", "pattern": "^https://"},
          "subreddit": {"type": "string", "pattern": "^[A-Za-z0-9_]{2,40}$"},
          "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
          "quality": {"enum": ["analyst", "vendor", "standards", "news", "community", "research"]},
          "note": {"type": "string"}
        }
      }
    }
  }
}
