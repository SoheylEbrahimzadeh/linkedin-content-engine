{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/settings.schema.json",
  "title": "Settings",
  "type": "object",
  "required": ["language", "timezone", "cadence", "approval", "publisher", "llm"],
  "additionalProperties": false,
  "properties": {
    "demo": {"type": "boolean"},
    "language": {"type": "string", "enum": ["en", "de", "fa"]},
    "languages_enabled": {"type": "array", "items": {"enum": ["en", "de", "fa"]}, "uniqueItems": true},
    "timezone": {"type": "string", "description": "IANA timezone name, e.g. Europe/Berlin"},
    "cadence": {
      "type": "object",
      "required": ["posts_per_week", "slots"],
      "additionalProperties": false,
      "properties": {
        "posts_per_week": {"type": "integer", "minimum": 1, "maximum": 7},
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["day", "time"],
            "additionalProperties": false,
            "properties": {
              "day": {"enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]},
              "time": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}
            }
          }
        }
      }
    },
    "approval": {
      "type": "object",
      "required": ["mode", "expire_unapproved"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["pull_request", "local"]},
        "expire_unapproved": {"const": true, "description": "Unapproved posts are never published."}
      }
    },
    "publisher": {
      "type": "object",
      "required": ["provider"],
      "additionalProperties": false,
      "properties": {
        "provider": {"enum": ["none", "manual", "linkedin_official", "publora"]},
        "max_lateness_minutes": {"type": "integer", "minimum": 0, "maximum": 1440}
      }
    },
    "llm": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "properties": {
        "runtime": {"const": "claude_code", "description": "LLM steps run inside Claude Code; the engine never calls an LLM API."}
      }
    }
  }
}
