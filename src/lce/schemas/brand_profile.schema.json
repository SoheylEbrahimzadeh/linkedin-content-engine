{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/brand_profile.schema.json",
  "title": "BrandProfile",
  "type": "object",
  "required": ["role_summary", "expertise", "positioning", "audience", "goals", "pillars", "forbidden"],
  "additionalProperties": false,
  "properties": {
    "demo": {"type": "boolean"},
    "role_summary": {"type": "string"},
    "expertise": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string"}},
    "positioning": {"type": "string"},
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "roles": {"type": "array", "items": {"type": "string"}},
        "industries": {"type": "array", "items": {"type": "string"}},
        "seniority": {"type": "array", "items": {"type": "string"}},
        "regions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "goals": {"type": "array", "items": {"type": "string"}},
    "pillars": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "name", "topics"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "name": {"type": "string"},
          "topics": {"type": "array", "items": {"type": "string"}},
          "max_share": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "forbidden": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "topics": {"type": "array", "items": {"type": "string"}},
        "claims": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
