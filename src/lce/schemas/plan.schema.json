{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lce/plan.schema.json",
  "title": "ContentPlan",
  "type": "object",
  "required": [
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "demo": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "topic",
          "pillar",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "topic": {
            "type": "string"
          },
          "pillar": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "angle": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "selected",
              "needs_input",
              "in_progress",
              "awaiting_approval",
              "approved",
              "ready_to_publish",
              "rejected",
              "skipped",
              "publishing",
              "published",
              "publish_failed",
              "needs_reconcile"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "candidate_id": {
            "type": "string"
          },
          "duplicate_check": {
            "enum": [
              "pending",
              "passed",
              "failed"
            ]
          },
          "draft_ref": {
            "type": "string"
          },
          "approval_status": {
            "enum": [
              "pending",
              "approved",
              "rejected"
            ]
          },
          "publication_status": {
            "enum": [
              "not_published",
              "ready_to_publish",
              "publishing",
              "published",
              "unknown"
            ],
            "description": "unknown = the publish request may or may not have reached LinkedIn (needs reconciliation)."
          },
          "objective": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        }
      }
    }
  }
}
